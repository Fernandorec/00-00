// --- Botones del menú ---
btn_width = 200;
btn_height = 50;
btn_spacing = 70;

var _center_x = room_width / 2;
var _start_y = room_height / 2 - btn_spacing;

btn_jugar_x = _center_x;
btn_jugar_y = _start_y;

btn_tutorial_x = _center_x;
btn_tutorial_y = _start_y + btn_spacing;

btn_creditos_x = _center_x;
btn_creditos_y = _start_y + btn_spacing * 2;